          "script": {
            "exec": [
              "pm.test('Status code es 200 OK o 429 Rate Limit', function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 429]);",
              "});",
              "if (pm.response.code === 200) {",
              "    pm.test('Responde el servicio de certificados', function () {",
              "        pm.response.to.have.header('X-Service-Name', 'servicio-certificados');",
