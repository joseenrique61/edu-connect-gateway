  "item": [
    {
      "name": "Estudiantes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Responde el servicio de estudiantes', function () {",
              "    pm.response.to.have.header('X-Service-Name', 'servicio-estudiantes');",
              "});",
              "pm.test('Estructura JSON válida de Estudiante', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('id', 101);",
              "    pm.expect(data).to.have.property('nombre', 'Ana Perez');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "edu-connect-secret-key"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "estudiantes"]
        }
      },
      "response": []
    },
