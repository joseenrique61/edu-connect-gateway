    {
      "name": "Certificados - Rate Limit Excedido",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "// Agotamos las 2 peticiones permitidas en segundo plano",
              "const requestConfig = {",
              "    url: pm.variables.get('baseUrl') + '/api/certificados',",
              "    method: 'GET',",
              "    header: [{ key: 'apikey', value: 'edu-connect-secret-key' }]",
              "};",
              "",
              "pm.sendRequest(requestConfig, function () {",
              "    pm.sendRequest(requestConfig, function () {",
              "        console.log('Cuota de certificados agotada previamente (2 peticiones realizadas).');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code es 429 Too Many Requests', function () {",
              "    pm.response.to.have.status(429);",
              "});",
              "",
              "pm.test('Mensaje de error oficial de Kong por Rate Limit', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data.message).to.eql('API rate limit exceeded');",
              "});",
              "",
              "pm.test('Kong incluye cabecera Retry-After', function () {",
              "    pm.response.to.have.header('Retry-After');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "edu-connect-secret-key"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/certificados",
          "host": ["{{baseUrl}}"],
          "path": ["api", "certificados"]
        }
      },
      "response": []
    }
